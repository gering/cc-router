#!/bin/sh
# Contract suites against freshly built binaries. Builds the production binary,
# the test driver and the test gateway into a temporary package layout
# (bin/ next to a share/ link, the resume bridge and the shim copied in as
# `make build` does), then runs every suite and reports all failures. The
# wrapper suites need zsh and python3.
set -eu

ROOT=$(cd "$(dirname "$0")/.." && pwd)
PKG=$(mktemp -d "${TMPDIR:-/tmp}/cc-router-tests.XXXXXX")
# INT/TERM only run the handler: without an explicit exit the script would
# resume and run the remaining suites against the deleted tree.
trap 'rm -rf -- "$PKG"' EXIT
trap 'rm -rf -- "$PKG"; exit 130' INT
trap 'rm -rf -- "$PKG"; exit 143' TERM
mkdir -p "$PKG/bin"
ln -s "$ROOT/share" "$PKG/share"
# Same toolchain as the Makefile, which passes its GO through.
GO=${GO:-go}
for target in cmd/cc-harness-agents tests/testdriver tests/gateway; do
  (cd "$ROOT" && "$GO" build -o "$PKG/bin/${target##*/}" "./$target")
done
cp "$ROOT/cmd/cc-harness-resume/cc-harness-resume" "$PKG/bin/"
mkdir -p "$PKG/bin/shim"
cp "$ROOT/cmd/claude-shim/claude" "$PKG/bin/shim/"

status=0
bash "$ROOT/tests/test-cc-harness-agents.sh" "$PKG" || status=1
bash "$ROOT/tests/test-claude-wrapper.sh" "$PKG" || status=1
CC_ROUTER_PKG="$PKG" python3 "$ROOT/tests/test-cc-harness-resume.py" || status=1
sh "$ROOT/tests/test-install.sh" "$PKG" || status=1
exit "$status"
